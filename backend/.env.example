# Quantara Environment Configuration
# ================================
# Copy this file to .env and fill in your values

# Google Gemini API Key (REQUIRED)
# Get a free key from: https://aistudio.google.com/app/apikey
# Note: Free tier has limited requests
GEMINI_API_KEY=your-gemini-api-key-here

# IBM Quantum Experience API Token (OPTIONAL)
# Get a free account and token from: https://quantum.ibm.com/
# Required for running circuits on real quantum hardware
IBM_QUANTUM_API_TOKEN=your-ibm-quantum-token-here
